{
  "name": "alpha-intelligence-remotion-starter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compositions": "remotion compositions src/index.ts",
    "render:preview": "remotion render src/index.ts AlphaIntelligenceStarter ../../outputs/alpha-starter-preview.mp4 --codec=h264 --crf=22 --scale=0.5",
    "render:master": "remotion render src/index.ts AlphaIntelligenceStarter ../../outputs/alpha-starter-master.mp4 --codec=h264 --audio-codec=aac --crf=16"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.2.8",
    "@fontsource/montserrat": "5.2.8",
    "@remotion/cli": "4.0.541",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "typescript": "5.8.3"
  }
}
