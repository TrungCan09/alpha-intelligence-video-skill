{
  "name": "alpha-intelligence-remotion-starter",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compositions": "remotion compositions src/index.ts",
    "render:preview": "remotion render src/index.ts AlphaIntelligenceStarter ../../outputs/alpha-starter-preview.mp4 --codec=h264 --crf=22 --scale=0.5 --concurrency=1 --disable-shared-memory-capture --gop=30",
    "render:primitives-preview": "remotion render src/index.ts AlphaPrimitivesDemo ../../outputs/alpha-primitives-preview.mp4 --codec=h264 --crf=22 --scale=0.5 --concurrency=1 --disable-shared-memory-capture --gop=30",
    "render:reference": "remotion render src/index.ts AlphaMotionReference10s ../../outputs/alpha-motion-reference-10s.mp4 --codec=h264 --audio-codec=aac --crf=16 --concurrency=1 --disable-shared-memory-capture --gop=30 --props=../../outputs/reference-props.json --overwrite",
    "render:reference20": "remotion render src/index.ts AlphaMotionReference20s ../../outputs/alpha-motion-reference-20s.mp4 --codec=h264 --audio-codec=aac --crf=16 --concurrency=1 --disable-shared-memory-capture --gop=30 --props=../../outputs/reference-20s-props.json --overwrite",
    "render:v2:reference": "remotion render src/index.ts AlphaVideoV2 ../reference/alpha-video-v2-reference.mp4 --codec=h264 --crf=17 --concurrency=1 --disable-shared-memory-capture --gop=30 --overwrite",
    "render:v2:candidate": "remotion render src/index.ts AlphaVideoV2 ../../outputs/alpha-video-v2-candidate.mp4 --codec=h264 --crf=16 --concurrency=1 --disable-shared-memory-capture --gop=30 --overwrite",
    "render:v2:semantic": "remotion render src/index.ts AlphaVideoV2Semantic ../../outputs/alpha-video-v2-semantic.mp4 --codec=h264 --crf=20 --scale=0.5 --concurrency=1 --disable-shared-memory-capture --gop=30 --overwrite",
    "render:v2:contact-sheet": "node ../../scripts/build-contact-sheet.mjs ../reference/alpha-video-v2-reference.mp4 --times 1,3,6,11 --out ../reference/alpha-video-v2-contact-sheet.png",
    "render:master": "node ../../scripts/finalize-master.mjs --candidate ../../outputs/alpha-video-v2-candidate.mp4 --transcript src/transcript.lock.json --cue-lock src/cue-sheet.lock.json --plan src/video-plan.json --project . --report ../../outputs/qa/report.json --out ../../outputs/alpha-video-v2-master.mp4"
  },
  "dependencies": {
    "@fontsource/montserrat": "5.2.8",
    "@remotion/captions": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/motion-blur": "4.0.541",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "typescript": "5.8.3"
  }
}
